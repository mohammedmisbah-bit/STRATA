# =============================================================================
# MOIL Reserve & Production Intelligence — environment template
#
# Copy to `.env` and fill in as needed:   cp .env.example .env
# `.env` is gitignored; this file is the committed reference.
#
# The dashboard runs with NONE of these set. Every service has a keyless
# default and a graceful fallback, so an empty .env is a valid configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# ⚠️  READ THIS BEFORE ADDING A SECRET
#
# Vite inlines every VITE_-prefixed variable into the client bundle as plain
# text. Anything with a VITE_ prefix is PUBLIC and extractable from the browser
# by anyone who opens devtools. It is not a secret, no matter what it is named.
#
#   VITE_*  -> shipped to the browser. Public config only.
#   no VITE_ prefix -> server-side only. Safe for credentials.
#
# Concretely: a Groq or Supabase service-role key MUST NOT be VITE_-prefixed.
# Route those calls through a TanStack server function or the FastAPI backend.
# -----------------------------------------------------------------------------


# === Translation: MyMemory (keyless) ========================================

# Master switch. Set to "false" to stop all outbound translation requests and
# keep the UI on English. Useful for offline demos, or if you would rather not
# send operational alert text to a third party.
# Default: true
VITE_TRANSLATION_ENABLED=true

# OPTIONAL quota uplift. MyMemory accepts a `de=<email>` parameter that raises
# the anonymous daily character allowance. Leave blank to stay fully anonymous.
#
# Tradeoff: because translation runs client-side, this address is compiled into
# the public bundle and is scrapeable. Use a role address, not a personal one.
VITE_MYMEMORY_CONTACT_EMAIL=

# Override the endpoint (self-hosted mirror or a paid plan). Blank = public API.
VITE_MYMEMORY_BASE_URL=


# === Weather: Open-Meteo (keyless) ==========================================

# Blank = the free public endpoint. Set to https://customer-api.open-meteo.com/v1/forecast
# if you move to a commercial plan.
VITE_OPEN_METEO_BASE_URL=


# === Synthetic data generator ===============================================

# PRNG seed for the mock production fixture. Change it to reshuffle the data.
# Must be an integer. The value is shared by the server and the browser so the
# two render passes agree — do not make this random.
# Default: 20260925
VITE_MOCK_SEED=20260925

# Number of daily records to generate. Default: 30
VITE_MOCK_RECORD_COUNT=30


# =============================================================================
# NOT YET WIRED — declared here so the shape is agreed before the work lands.
# Nothing reads these today.
# =============================================================================

# --- FastAPI backend --------------------------------------------------------
# Base URL of the Python inference service. Blank = use local computation only.
VITE_API_BASE_URL=

# --- Supabase ---------------------------------------------------------------
# The anon key is designed to be public and is safe to expose PROVIDED row
# level security is enabled on every table. Enable RLS before shipping.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS entirely. Never give this a VITE_ prefix and
# never reference it from a file that the client bundle can reach.
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (Llama-3.3-70B mitigation directives) -----------------------------
# THE ONE TO USE. Read server-side by a TanStack Start server function, so the
# key never reaches the browser. This is the default transport.
GROQ_API_KEY=

# ⚠️  DANGEROUS. Vite compiles this into the public client bundle, so the key is
# readable by anyone who views source. Groq bills per token, so a leaked key is
# a billable account for strangers.
#
# It exists only because a direct browser call is convenient for a throwaway
# demo. It is ignored unless VITE_GROQ_ALLOW_CLIENT_KEY is also true, and the UI
# shows a red "Client key" warning while it is active. Never use a production
# key here, and never ship it.
VITE_GROQ_API_KEY=
VITE_GROQ_ALLOW_CLIENT_KEY=false

# Primary model (public config, not a secret). llama-3.3-70b-versatile was
# retired on free/developer tiers on 16 Aug 2026 and now returns 404. If this
# model 404s, the service falls through to openai/gpt-oss-120b, then -20b.
VITE_GROQ_MODEL=openai/gpt-oss-120b

# --- Copernicus Data Space (satellite prospectivity pipeline) ---------------
# OAuth client from https://shapps.dataspace.copernicus.eu/dashboard (User
# settings → OAuth clients). Used ONLY by pipeline/strata_pipeline.py on your
# machine, never by the web app, so do not add these to Netlify.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
